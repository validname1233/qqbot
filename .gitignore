# ---------- 依赖 ----------
# 体积大且平台相关（Windows 装的包在 Linux 未必能用），由 package.json 重装。
node_modules/

# ---------- 凭据（最重要）----------
# AppSecret 泄露 = 别人能冒充你的机器人。这些绝对不能进版本库。
# .env.example 是模板，不含真实值，可以提交——所以用 ! 排除掉它。
.env
.env.*
!.env.example

# ---------- 日志 ----------
*.log
logs/
npm-debug.log*

# ---------- pm2 / 进程管理 ----------
.pm2/

# ---------- 构建产物 ----------
# 目前用 tsx 直接跑源码，暂无产物；将来 tsc 编译到 dist/ 时用得上。
dist/

# ---------- 编辑器 / 系统杂物 ----------
.vscode/
.idea/
.DS_Store
Thumbs.db
